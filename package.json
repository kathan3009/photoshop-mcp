{
  "name": "photoshop-mcp",
  "version": "1.2.1",
  "description": "Drive the Adobe Photoshop running on your Mac from Claude, Cursor, Codex and other MCP clients \u2014 MCP server, CLI and agent skill on one tested core",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "photoshop-mcp": "bin/photoshop-mcp.mjs",
    "psctl": "cli.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "setup": "node bin/photoshop-mcp.mjs setup",
    "doctor": "node bin/photoshop-mcp.mjs doctor",
    "test": "node test/e2e.mjs",
    "trial": "node test/agent-trial.mjs",
    "test:release": "node --test test/release.test.mjs",
    "test:smoke": "node test/source-smoke.mjs"
  },
  "keywords": [
    "photoshop",
    "mcp",
    "model-context-protocol",
    "claude",
    "agent",
    "automation",
    "macos"
  ],
  "author": "Kathan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kathan3009/photoshop-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "bin/",
    "server.mjs",
    "cli.mjs",
    "src/",
    "jsx/",
    "skill/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
